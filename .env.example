# Copy to .env and fill in.   chmod 600 .env
MERAKI_API_KEY=

# Your local time zone (IANA name). Used for every time shown and for the times you
# type in the plan. Set it explicitly on WSL/Kali, where the system zone is often UTC.
LOCAL_TZ=America/Chicago

# Output (relative paths are relative to this folder)
OUTPUT_FILE=output/meraki_inventory.xlsx
PLAN_FILE=output/firmware_plan.xlsx
EXCLUSIONS_FILE=exclusions.txt
LOG_DIR=logs

# Keep this many dated runs (Devices/Changes/Summary sheet sets) in the workbook
KEEP_RUNS=30
# Also write output/devices_<date>.csv for every report run
CSV_EXPORT=true

# Refuse to schedule an upgrade less than this many minutes from now
MIN_LEAD_MINUTES=15
# template = template-bound networks are scheduled once on their template
# network  = every network (bound or not) gets its own plan row
TEMPLATE_FIRMWARE_MODE=template
